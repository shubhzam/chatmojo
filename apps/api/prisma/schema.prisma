// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7))
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sentMessages         Message[]
  conversationsAsUserA Conversation[] @relation("ConversationUserA")
  conversationsAsUserB Conversation[] @relation("ConversationUserB")
  groupsCreated    GroupConversation[] @relation("GroupsCreated")
  groupMemberships GroupMembership[]
  groupMessages    GroupMessage[]
}

model Conversation {
  id            String   @id @default(uuid(7))
  userAId       String
  userBId       String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  userA    User      @relation("ConversationUserA", fields: [userAId], references: [id])
  userB    User      @relation("ConversationUserB", fields: [userBId], references: [id])
  messages Message[]

  @@unique([userAId, userBId])
}

model Message {
  id             String   @id @default(uuid(7))
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, id])
}

model GroupConversation {
  id            String   @id @default(uuid(7))
  name          String
  createdBy     String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  creator     User               @relation("GroupsCreated", fields: [createdBy], references: [id])
  memberships GroupMembership[]
  messages    GroupMessage[]
}

model GroupMembership {
  userId              String
  groupConversationId String
  joinedAt            DateTime @default(now())

  user  User              @relation(fields: [userId], references: [id])
  group GroupConversation @relation(fields: [groupConversationId], references: [id])

  @@id([userId, groupConversationId])
  @@index([groupConversationId])
}

model GroupMessage {
  id                  String   @id @default(uuid(7))
  groupConversationId String
  senderId            String
  content             String
  createdAt           DateTime @default(now())

  group  GroupConversation @relation(fields: [groupConversationId], references: [id])
  sender User              @relation(fields: [senderId], references: [id])

  @@index([groupConversationId, id])
}